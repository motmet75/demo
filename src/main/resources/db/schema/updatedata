-- Drop any existing single-column unique constraint/index on material_code
DO $$
DECLARE
  c RECORD;
BEGIN
  FOR c IN
    SELECT con.oid::regclass::text AS constraint_name
    FROM pg_constraint con
    JOIN pg_class rel ON rel.oid = con.conrelid
    JOIN pg_attribute att ON att.attrelid = rel.oid
    WHERE rel.relname = 'material'
      AND con.contype = 'u'
      AND con.conkey = ARRAY[att.attnum]
      AND att.attname = 'material_code'
  LOOP
    EXECUTE format('ALTER TABLE material DROP CONSTRAINT IF EXISTS %I', c.constraint_name);
  END LOOP;

  -- Also drop any unique index directly on material_code (created by UNIQUE in some setups)
  PERFORM pg_try_advisory_lock(1);
  FOR c IN
    SELECT indexname AS constraint_name FROM pg_indexes WHERE tablename = 'material' AND indexdef LIKE '%(material_code)%' AND indexdef LIKE '%UNIQUE%'
  LOOP
    EXECUTE format('DROP INDEX IF EXISTS %I', c.constraint_name);
  END LOOP;
  PERFORM pg_advisory_unlock(1);
END
$$;

-- Add composite unique constraint if not exists
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_constraint con
    JOIN pg_class rel ON rel.oid = con.conrelid
    WHERE rel.relname = 'material'
      AND con.contype = 'u'
      AND (SELECT array_agg(att.attname ORDER BY i) FROM (
            SELECT unnest(con.conkey) WITH ORDINALITY AS a(attnum, i)
            JOIN pg_attribute att ON att.attnum = a.attnum AND att.attrelid = rel.oid
          ) sub(attname, i)
         ) = ARRAY['tenant_id','company_id','material_code']
  ) THEN
    ALTER TABLE material
      ADD CONSTRAINT uq_material_tenant_company_code UNIQUE (tenant_id, company_id, material_code);
  END IF;
END
$$;


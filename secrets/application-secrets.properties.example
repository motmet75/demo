# ============================================================================
# SECRETS CONFIGURATION - COPY TO secrets/application-secrets.properties
# ============================================================================
# IMPORTANT: 
# 1. Copy this file to: secrets/application-secrets.properties
# 2. Add your actual credentials
# 3. Add secrets/ folder to .gitignore (DO NOT COMMIT SECRETS!)
# ============================================================================

# ============================================================================
# MAIL CONFIGURATION
# ============================================================================
# Gmail SMTP Settings
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@gmail.com
spring.mail.password=your-app-specific-password

# For Gmail: Generate App Password at https://support.google.com/accounts/answer/185833
# DO NOT USE YOUR ACCOUNT PASSWORD - Use the 16-character App Password instead

# Alternative Email Providers:
# Microsoft 365: smtp.office365.com:587
# SendGrid: smtp.sendgrid.net:587
# AWS SES: email-smtp.region.amazonaws.com:587
# Mailgun: smtp.mailgun.org:587

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
spring.datasource.url=jdbc:postgresql://localhost:5432/anhmedia
spring.datasource.username=postgres
spring.datasource.password=your-db-password

# ============================================================================
# SHOP CONFIGURATION
# ============================================================================
app.shop.public-base-url=http://localhost:5173/bom-inventory

# For production, set to your actual domain:
# app.shop.public-base-url=https://yourdomain.com/shop

# ============================================================================
# OPTIONAL: JWT/Security Configuration
# ============================================================================
# jwt.secret=your-jwt-secret-key-min-32-characters-long
# jwt.expiration=86400000

# ============================================================================
# OPTIONAL: Cloud Storage (if using S3, GCS, etc)
# ============================================================================
# aws.s3.bucket=your-bucket-name
# aws.s3.region=us-east-1
# aws.s3.access-key=your-access-key
# aws.s3.secret-key=your-secret-key
